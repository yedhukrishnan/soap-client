{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SOAP Client",
  "version": "0.2.0",
  "identifier": "dev.soapclient.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SOAP Client",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "connect-src": "ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420",
        "script-src": "'self' http://localhost:1420",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Small, secure, clutter-free desktop client for testing SOAP web services",
    "longDescription": "Import a WSDL, get ready-made requests for every operation, and send them with environments, variables, authentication and response checks. Secrets are kept in the system keyring, never in project files.",
    "publisher": "Yedhu Krishnan",
    "copyright": "\u00a9 2026 Yedhu Krishnan \u00b7 MIT License",
    "homepage": "https://github.com/yedhukrishnan/soap-client",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libdbus-1-3"
        ],
        "section": "devel",
        "files": {
          "/usr/share/doc/soap-client/copyright": "../LICENSE"
        }
      }
    },
    "license": "MIT",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
