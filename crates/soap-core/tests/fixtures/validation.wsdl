<?xml version="1.0"?>
<!-- Exercises the request validator: one document/literal operation whose payload uses
     most of the XML Schema features the validator understands. -->
<wsdl:definitions targetNamespace="urn:shop"
  xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
  xmlns:s="urn:shop" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <wsdl:types>
    <xs:schema targetNamespace="urn:shop" elementFormDefault="qualified" xmlns="urn:shop">
      <xs:simpleType name="Code">
        <xs:restriction base="xs:token"><xs:minLength value="2"/><xs:maxLength value="2"/></xs:restriction>
      </xs:simpleType>
      <xs:simpleType name="Size">
        <xs:restriction base="xs:string">
          <xs:enumeration value="Small"/><xs:enumeration value="Medium"/><xs:enumeration value="Large"/>
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType name="Qty">
        <xs:restriction base="xs:int"><xs:minInclusive value="1"/><xs:maxInclusive value="99"/></xs:restriction>
      </xs:simpleType>
      <xs:simpleType name="Price">
        <xs:restriction base="xs:decimal"><xs:fractionDigits value="2"/></xs:restriction>
      </xs:simpleType>
      <xs:simpleType name="SizeOrAuto">
        <xs:union memberTypes="Size">
          <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="auto"/></xs:restriction></xs:simpleType>
        </xs:union>
      </xs:simpleType>
      <xs:simpleType name="Tags"><xs:list itemType="xs:int"/></xs:simpleType>

      <xs:complexType name="Party">
        <xs:sequence><xs:element name="name" type="xs:string"/></xs:sequence>
        <xs:attribute name="id" type="xs:int" use="required"/>
      </xs:complexType>
      <xs:complexType name="Customer">
        <xs:complexContent>
          <xs:extension base="Party">
            <xs:sequence><xs:element name="email" type="xs:string" minOccurs="0"/></xs:sequence>
          </xs:extension>
        </xs:complexContent>
      </xs:complexType>
      <xs:complexType name="Money">
        <xs:simpleContent>
          <xs:extension base="Price"><xs:attribute name="currency" type="Code"/></xs:extension>
        </xs:simpleContent>
      </xs:complexType>

      <xs:group name="Delivery">
        <xs:choice>
          <xs:element name="pickup" type="xs:boolean"/>
          <xs:element name="address" type="xs:string"/>
        </xs:choice>
      </xs:group>

      <xs:element name="payment" abstract="true"/>
      <xs:element name="card" type="xs:string" substitutionGroup="payment"/>
      <xs:element name="voucher" type="xs:string" substitutionGroup="payment"/>

      <xs:element name="PlaceOrder">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="customer" type="Customer"/>
            <xs:element name="line" maxOccurs="3">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="sku" type="Code"/>
                  <xs:element name="qty" type="Qty"/>
                  <xs:element name="size" type="SizeOrAuto" minOccurs="0"/>
                  <xs:element name="price" type="Money"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:group ref="Delivery"/>
            <xs:element ref="payment"/>
            <xs:element name="options" minOccurs="0">
              <xs:complexType>
                <xs:all>
                  <xs:element name="giftWrap" type="xs:boolean"/>
                  <xs:element name="note" type="xs:string" minOccurs="0"/>
                </xs:all>
              </xs:complexType>
            </xs:element>
            <xs:element name="tags" type="Tags" minOccurs="0"/>
            <xs:element name="due" type="xs:date" nillable="true"/>
            <xs:element name="channel" type="xs:string" fixed="web" minOccurs="0"/>
            <xs:any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:schema>
  </wsdl:types>
  <wsdl:message name="PlaceOrderIn"><wsdl:part name="body" element="s:PlaceOrder"/></wsdl:message>
  <wsdl:portType name="ShopPort">
    <wsdl:operation name="PlaceOrder"><wsdl:input message="s:PlaceOrderIn"/></wsdl:operation>
  </wsdl:portType>
  <wsdl:binding name="ShopSoap" type="s:ShopPort">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="PlaceOrder">
      <soap:operation soapAction="urn:shop:PlaceOrder"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
    </wsdl:operation>
  </wsdl:binding>
</wsdl:definitions>
