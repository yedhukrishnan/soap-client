{
  "name": "soap-client",
  "private": true,
  "version": "0.2.0",
  "description": "A lightweight SOAP client for macOS and Linux",
  "author": "Yedhu Krishnan <dev@yedhu.me> (https://yedhu.me)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yedhukrishnan/soap-client.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "build:mac": "tauri build --config src-tauri/tauri.signing.json",
    "release:mac": "bash scripts/release-mac.sh",
    "release:linux": "bash scripts/release-linux.sh"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.6",
    "@tsconfig/svelte": "^5.0.9",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "monaco-editor": "^0.57.0"
  },
  "overrides": {
    "dompurify": "^3.4.18"
  }
}
